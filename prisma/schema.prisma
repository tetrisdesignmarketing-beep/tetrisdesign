generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// CMS layout landing — một row / trang. `content` JSON theo slug:
/// home: { slides: HeroSlide[] }
/// about: siteAbout
/// services: { items: SiteService[] }
/// contact: { email, phone, addressLine, province, address }
/// projects: placeholder (list dự án = Post)
/// @see docs/architecture/DECISIONS.md
model SitePage {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Layout gallery trang chi tiết dự án (`/projects/[slug]`).
/// LAYOUT1 = hiện tại (GSAP grid); LAYOUTDEFAULT = stack ảnh static; LAYOUT2 = chưa FE.
enum PostLayoutStyle {
  LAYOUTDEFAULT
  LAYOUT1
  LAYOUT2
}

/// Bài đăng = dự án / portfolio (title, address, concept, category, description, images).
/// content + excerpt: deprecated — form/API admin không ghi; giữ cột cho /blog.
model Post {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  address     String          @default("")
  concept     String          @default("")
  /// Block thông tin trang chi tiết (text tự do, không bắt buộc). Vị trí = address.
  area        String          @default("")
  designYear  String          @default("")
  architect   String          @default("")
  description String          @default("") @db.Text
  coverImage  String?
  /// Gallery — map `SiteProject.gallery`
  images      String[]        @default([])
  /// Gallery layout trên trang detail — map `SiteProject.layoutStyle`
  layoutStyle PostLayoutStyle @default(LAYOUT1)
  published   Boolean         @default(false)
  /// Ưu tiên cao nhất: lên đầu /projects (mọi tab) và "Dự án khác", trước sortOrder.
  featured    Boolean         @default(false)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// @deprecated — không dùng form/API admin; /blog còn đọc
  content     String?         @db.Text
  /// @deprecated — không dùng form/API admin; /blog còn đọc
  excerpt     String?
  /// Thứ tự thủ công — admin kéo thả ở /admin/posts; cũng dùng để sắp xếp danh sách public.
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([published, createdAt(sort: Desc)])
  @@index([slug])
  @@index([categoryId])
  @@index([sortOrder])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  title     String   @default("")
  path      String
  url       String
  mimeType  String
  size      Int
  type      String
  /// Kích thước ảnh đã lưu (sau xoay EXIF / nén). Null: video, SVG, ảnh cũ chưa backfill.
  width     Int?
  height    Int?
  /// Ảnh mờ siêu nhỏ (data URI WebP ~20px, ~400 ký tự) — hiện ngay trong HTML
  /// trước khi ảnh thật tải (LQIP). Null: video, SVG, ảnh cũ chưa backfill.
  placeholder String?
  createdAt DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([title])
}

/// Tin tức (/tin-tuc) — tách riêng khỏi Post (dự án).
/// `content` = danh sách khối JSON (đoạn văn TipTap / ảnh) — xem lib/validations/news.ts.
model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("") @db.Text
  coverImage  String?
  content     Json     @default("[]")
  /// Có giá trị → tin là link ngoài: click mở trang này (tab mới), /tin-tuc/[slug] redirect sang.
  externalUrl String?
  published   Boolean  @default(false)
  /// Ưu tiên cao nhất: lên đầu /tin-tuc và "Tin khác", trước publishedAt.
  featured    Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt(sort: Desc)])
}
